          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"book_sources\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"url\" TEXT NOT NULL, \"fingerprint\" TEXT NOT NULL, \"payload\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"group_name\" TEXT NULL, \"comment\" TEXT NULL, \"source_type\" INTEGER NOT NULL DEFAULT 0, \"is_enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_enabled\" IN (0, 1)), \"custom_order\" INTEGER NOT NULL DEFAULT 0, \"is_explore_enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_explore_enabled\" IN (0, 1)), \"weight\" INTEGER NOT NULL DEFAULT 0, \"last_update_time\" INTEGER NULL, \"respond_time\" INTEGER NULL, \"imported_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, UNIQUE (\"url\", \"fingerprint\"));"
        }
      ]
